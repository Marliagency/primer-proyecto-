# ============================================================
# Marli Agency · Variables de entorno (esquema, sin valores reales)
# ============================================================
#
# 1. Copia este archivo a `.env` (que está en .gitignore).
# 2. Rellena los valores reales en `.env`.
# 3. NUNCA commits el `.env` real ni pegues estos valores en chat.
# 4. Lee primero la política completa: 11-INTEGRACIONES/SECURITY.md
#
# ============================================================

# --- Notion (CRM principal) -----------------------------------
# Crear en https://www.notion.so/my-integrations
# Permisos mínimos: Read content, Update content, Insert content
# Compartir solo las DBs concretas (no el workspace entero).
NOTION_INTEGRATION_TOKEN=
NOTION_DB_PACIENTES_ID=
NOTION_DB_SESIONES_ID=
NOTION_DB_LEADS_ID=
NOTION_DB_CLIENTES_ID=

# --- n8n (orquestador) ----------------------------------------
# Self-hosted: definir N8N_ENCRYPTION_KEY (NO rotar nunca).
# Generar con: openssl rand -hex 32
N8N_HOST=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL_LEAD_MAGNET=
N8N_WEBHOOK_URL_STRIPE=
N8N_WEBHOOK_URL_CALENDLY=

# --- Anthropic (Claude API) -----------------------------------
# Crear en https://console.anthropic.com
# Crear KEYS separadas para chatbot Li y para informes (rate limits
# y observabilidad por separado).
ANTHROPIC_API_KEY_CHATBOT=
ANTHROPIC_API_KEY_INFORMES=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# --- Stripe (cobro) -------------------------------------------
# Crear en https://dashboard.stripe.com/apikeys
# Modo TEST y LIVE separados. Restringir secret key a los endpoints
# que usa n8n (Restricted API key).
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PACK_PREMIUM=
STRIPE_PRICE_ID_PACK_PREMIUM_INSTALACION=
STRIPE_PRICE_ID_MANTENIMIENTO=

# --- Cloudflare Email Service ---------------------------------
# Configurar Email Routing + Email Sending en el dashboard CF.
# DKIM, SPF, DMARC obligatorios antes de cualquier envío.
CF_ACCOUNT_ID=
CF_API_TOKEN_EMAIL=
CF_EMAIL_FROM=hola@marliagency.com
CF_EMAIL_REPLY_TO=hola@marliagency.com

# --- Calendly ------------------------------------------------
# Personal Access Token (no usar OAuth si no necesitas multi-cuenta).
# Webhook subscriptions para invitee.created y invitee.canceled.
CALENDLY_PAT=
CALENDLY_USER_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- Meta Ads (Fase 2) ---------------------------------------
# Crear App en developers.facebook.com con permisos ads_read,
# ads_management. System User con scope mínimo.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
META_CONVERSION_API_TOKEN=

# --- Google Ads (Fase 3) -------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Google Analytics 4 --------------------------------------
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- WordPress (Blog SEO Fase 2-3) ---------------------------
# Application Password, no la contraseña del usuario admin.
WP_BASE_URL=https://marliagency.com
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# --- WhatsApp Business API (Fase 2) -------------------------
# Vía proveedor (360dialog, MessageBird, etc.). NO API directa de Meta
# para volumen pequeño.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Observabilidad / alertas --------------------------------
# Errores y alertas críticas (caída chatbot Li, fallo cobro, etc.)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_OPS=
SENTRY_DSN=

# ============================================================
# RECORDATORIO FINAL
# Si has rellenado este archivo: NO lo commits. NO lo subas a chat.
# Si crees que se ha filtrado: rota TODO inmediatamente.
# ============================================================
